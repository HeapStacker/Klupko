{
    "editor.formatOnSave": true,
    "xmake.autoGenerateCompileCommands": "onBuild",
    //
    // ghost avatar...
    "background.editor": {
        "useFront": true,
        "style": {
            "background-position": "98% 92%",
            "background-size": "180px",
            "opacity": 0.3
        },
        "images": [
            "https://i.pinimg.com/originals/8d/d1/76/8dd176c04a07c37b80a640dbc73382ff.gif"
        ],
        "interval": 0,
        "random": false
    },
    //
    // debugging...
    "xmake.debugConfigType": "codelldb",
    "xmake.runMode": "buildRun",
    "xmake.customDebugConfig": {
        "stopAtEntry": false
    }
}